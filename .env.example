# =====================================================================
# GLOBAL AI OPPORTUNITIES INTELLIGENCE AGENT - ENVIRONMENT CONFIGURATION
# =====================================================================

# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# Database configuration (SQLite by default, PostgreSQL compatible)
DATABASE_URL=sqlite+aiosqlite:///data/database/opportunities.db
DATABASE_SYNC_URL=sqlite:///data/database/opportunities.db

# LLM Provider Configuration (Optional - deterministic fallback is used if empty)
# Supported providers: gemini, openai, anthropic, groq, none
LLM_PROVIDER=none
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Search Provider Configuration for Source Discovery
# Supported providers: duckduckgo, searxng, serper, serpapi, google
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARXNG_BASE_URL=

# Browser Automation & Persistent Session Directory (User-controlled login)
PLAYWRIGHT_USER_DATA_DIR=data/browser_profiles/default
PLAYWRIGHT_HEADLESS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log

# Pipeline Limits & Defaults
MAX_CONCURRENT_CONNECTORS=5
CONNECTOR_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
